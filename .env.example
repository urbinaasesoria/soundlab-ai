# ============================================================================
#  SoundLab AI — variables de entorno (EJEMPLO)
#  © 2026 URBINA ASESORÍA E INVERSIONES S.A.C.
#
#  Copia este archivo a `.env.local` y rellena los valores EN TU MÁQUINA.
#  `.env.local` está en .gitignore y nunca debe subirse ni pegarse en un chat.
#
#  REGLA DE ORO: ninguna clave con prefijo VITE_ es secreta. Vite las incrusta
#  en el bundle y cualquiera puede leerlas desde el navegador. Las claves van
#  SIEMPRE en el proxy (server/) y nunca en el cliente.
# ============================================================================

# --- Proxy de IA (server/gemini-proxy.mjs) ---------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo a usar. Flash es el equilibrio coste/calidad recomendado.
GEMINI_MODEL=gemini-2.5-flash

# Puerto local del proxy (el cliente lo busca aquí si VITE_AI_PROXY está vacío).
PORT=8787

# Origen permitido para CORS (el servidor de desarrollo de Vite).
ALLOW_ORIGIN=http://localhost:5180

# --- Cliente web (público, sin secretos) -----------------------------------
# URL del proxy. En producción será la del Worker/función desplegada.
# Déjalo vacío para desactivar la IA: la app funciona igual, sin copiloto.
VITE_AI_PROXY=http://localhost:8787

# --- Supabase (Base de datos y autenticación) -------------------------------
VITE_SUPABASE_URL=https://pkjunhbuormzdkhbrxfd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_HXL685onWMEo-4shko9J8g_nPVysfUf
SUPABASE_URL=https://pkjunhbuormzdkhbrxfd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_HXL685onWMEo-4shko9J8g_nPVysfUf
