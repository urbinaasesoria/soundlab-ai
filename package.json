{
  "name": "soundlab-ai",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "SoundLab AI — laboratorio de audio en el navegador: diagnóstico técnico, compositor de prompts para Suno, corrección con DSP real y certificación de integridad. Propiedad de URBINA ASESORÍA E INVERSIONES S.A.C.",
  "author": "URBINA ASESORÍA E INVERSIONES S.A.C.",
  "license": "UNLICENSED",
  "copyright": "© 2026 URBINA ASESORÍA E INVERSIONES S.A.C. Todos los derechos reservados.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "node --import ./tests/register.mjs --test tests/smoke.test.ts tests/engine.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=high",
    "dataset:make": "node --import ./tests/register.mjs scripts/make-dataset.mjs",
    "dataset:ingest": "node --import ./tests/register.mjs scripts/ingest-real-audio.mjs",
    "ai:proxy": "node --env-file=.env.local server/gemini-proxy.mjs",
    "ai:check": "node scripts/check-gemini.mjs",
    "model:train": "node scripts/train-model.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
